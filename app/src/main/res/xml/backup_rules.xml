<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy Auto Backup rules for API < 31. The app's minSdk is 31, so in practice
   data_extraction_rules.xml governs backup/transfer; these rules are kept in
   sync for completeness. See
   https://developer.android.com/guide/topics/data/autobackup

   Exclude the shared-preferences files that hold credentials, PII, or
   per-install identity (the encrypted BYO OpenAI key, PII such as the
   cloud-sync email, and the per-install analytics UUID).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_settings.xml" />
    <exclude domain="sharedpref" path="local_only_prefs.xml" />
    <exclude domain="sharedpref" path="local_only_app_prefs.xml" />
</full-backup-content>

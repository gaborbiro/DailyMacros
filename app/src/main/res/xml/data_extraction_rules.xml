<?xml version="1.0" encoding="utf-8"?>
<!--
   Controls Android Auto Backup (cloud) and device-to-device transfer on API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   We exclude the shared-preferences files that hold credentials, PII, or
   per-install identity that must not travel with a restore:
   - secure_settings.xml : the encrypted BYO OpenAI key (see SecureApiKeyStore).
     Its ciphertext is bound to this device's Keystore master key, which is
     non-exportable, so a restored copy could never be decrypted on another
     device — and it is a credential, so it must not leave the device regardless.
   - local_only_prefs.xml : PII that isn't a device setting, e.g. the cloud-sync
     email (see LocalOnlyPrefsStore).
   - local_only_app_prefs.xml : the per-install analytics UUID (see AppPrefs).
     Restoring it onto a different install would make analytics treat a fresh
     install as a continuation of the old one.

   `prefs.xml`/`app_prefs.xml` (app settings, targets, trends, onboarding flag,
   etc.) are NOT excluded and back up normally, along with the food/health
   database and thumbnails, matching the trust boundary of the in-app Drive
   backup and enabling restore on a new device. BackupRepositoryImpl (the
   in-app path) mirrors these same three exclusions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_settings.xml" />
        <exclude domain="sharedpref" path="local_only_prefs.xml" />
        <exclude domain="sharedpref" path="local_only_app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_settings.xml" />
        <exclude domain="sharedpref" path="local_only_prefs.xml" />
        <exclude domain="sharedpref" path="local_only_app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

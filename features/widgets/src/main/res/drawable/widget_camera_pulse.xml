<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanding, fading disc behind the widget's camera button (mirrors the web demo's demo-pulse).
    Widgets can't run animations directly; this plays as the indeterminate drawable of a
    ProgressBar (see layout/widget_camera_pulse.xml), which the launcher keeps animating.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <group
                android:name="disc"
                android:pivotX="24"
                android:pivotY="24">
                <path
                    android:name="fill"
                    android:fillColor="@android:color/white"
                    android:pathData="M24,0 A24,24 0 1,1 24,48 A24,24 0 1,1 24,0 Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="disc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1600"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <propertyValuesHolder
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="fill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1600"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:propertyName="fillAlpha"
                android:repeatCount="infinite"
                android:valueFrom="0.8"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>

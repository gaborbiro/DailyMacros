<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Re-arms the meal reminder alarm after a reboot (MealReminderAlarmReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <receiver
            android:name=".photodiary.PhotoRecognitionActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.gaborbiro.dailymacros.ACTION_CONFIRM_PHOTO_ENTRY" />
                <action android:name="dev.gaborbiro.dailymacros.ACTION_DENY_PHOTO_ENTRY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".mealreminders.MealReminderAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.gaborbiro.dailymacros.ACTION_MEAL_REMINDER_ALARM" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".timezone.TimezoneChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
